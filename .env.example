# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored so your email stays private.

# Required by SEC.gov — identifies your site in all API requests.
# SEC asks for a descriptive string with contact info, typically name + email.
SEC_USER_AGENT=EDGAR Terminal contact@secedgarterminal.com

# Required by deployed runtimes for one shared SEC request-start budget.
# Local development can omit these and uses a conservative instance pacer.
KV_REST_API_URL=https://your-upstash-endpoint
KV_REST_API_TOKEN=your-upstash-token

# Optional server-only token for higher CFTC Public Reporting API quotas.
# Official tokenless public requests remain supported.
CFTC_APP_TOKEN=

# Optional provider-free rollback switch. CFTC is enabled by default; set to
# 0 or false and redeploy to pause its UI, public APIs, and refresh cron while
# keeping SEC research and all retired-provider 410 routes active.
CFTC_ENABLED=1

# Required on deployed cron routes. Vercel sends this value as a Bearer token.
CRON_SECRET=replace-with-a-long-random-secret
# Explicit overrides for staged durable data. Production otherwise uses reviewed
# defaults in dataStoreDeployment.js and short-lived Vercel workload identity.
# These off values provide an independent rollback for each dataset.
# Never put secret/service keys in NEXT_PUBLIC_* or in a Vercel Preview environment.
# SUPABASE_URL is restricted to the named EDGAR project or a local rehearsal API.
# Production needs no copied Supabase secret when using the OIDC gateway.
EDGAR_DATASTORE_CFTC=off
EDGAR_DATASTORE_SEC=off
EDGAR_DATASTORE_FINANCIAL=off
# Enable only after approval; reuses existing prewarm cron, with four-issuer cap.
EDGAR_DATASTORE_SEC_SCHEDULE=0
SUPABASE_URL=https://vvkihuduqqnxqahhbphs.supabase.co
SUPABASE_SECRET_KEY=
# Legacy JWT service-role key is supported only when SUPABASE_SECRET_KEY is absent.
SUPABASE_SERVICE_ROLE_KEY=
# Use production only in approved production configuration; isolated trusted local
# round trips use rehearsal. A namespace does not restrict a privileged key.
EDGAR_DATASTORE_NAMESPACE=rehearsal
EDGAR_DATASTORE_TRUSTED_INGEST=0
