# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored so your email stays private.

# Required by SEC.gov — identifies your site in all API requests.
# SEC asks for a descriptive string with contact info, typically name + email.
SEC_USER_AGENT=EDGAR Terminal contact@secedgarterminal.com

# Required by deployed runtimes for one shared SEC request-start budget.
# Local development can omit these and uses a conservative instance pacer.
KV_REST_API_URL=https://your-upstash-endpoint
KV_REST_API_TOKEN=your-upstash-token
